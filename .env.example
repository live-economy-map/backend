# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/template_db

# JWT
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Client
CLIENT_URL=http://localhost:3000

# Google Earth Engine (VIIRS / GHSL pulls)
GOOGLE_EARTH_ENGINE_CREDENTIALS=dev_placeholder_credentials

# GDELT
GDELT_API_KEY=dev_placeholder_key

# LLM (aiClient.ts)
LLM_API_KEY=dev_placeholder_key

# Admin seed (prisma/seed.ts)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=dev_placeholder_password_123